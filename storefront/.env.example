# Storefront (Next.js) — variables de entorno.
# En dev podés dejar todo en localhost (estos son los defaults si no setéas nada).
# En prod, setealas con tus dominios reales.

# URL de la API desde el servidor (SSR). Prod: https://api.tudominio.com
API_URL=http://localhost:5080

# URL de la API desde el browser (client-side: carrito, favoritos, auth, tracking).
NEXT_PUBLIC_API_URL=http://localhost:5080

# Dónde vive el panel: el link "Entrar al panel" de la portada y la validación
# de los mensajes del editor de tienda (que compara contra el origin exacto).
# REQUERIDA en prod: https://admin.tudominio.com
NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:5173

# Toda dirección es la de una tienda, el dominio raíz incluido. El host se
# resuelve contra los tenants: primero por dominio propio y si no por
# subdominio (mitienda.tudominio.com -> tenant "mitienda"). Un host sin
# tienda detrás muestra "tienda no encontrada".
#
# Dominio base de la instalación y qué tienda atiende el dominio pelado.
# Dev: localhost + la tienda que quieras ver en localhost:3000.
PLATFORM_BASE_DOMAIN=localhost
PRIMARY_STORE_SUBDOMAIN=puenteoriente
