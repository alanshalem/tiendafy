# Claude Code: lo local (settings.local.json, worktrees/, locks) queda afuera;
# las skills del proyecto se versionan (ver .claude/skills/README.md).
.claude/*
!.claude/skills/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# .NET / C#
bin/
obj/
*.dll
*.exe
*.pdb
*.user
*.suo
.vs/
.vs
appsettings.local.json
.env.local

# Node
node_modules/
dist/
build/
.next/
out/
*.tsbuildinfo

# Package managers
.pnpm-store/

# Environment (todas las variantes tienen secretos; las plantillas .example sí van)
.env
.env.*
!.env.example
!.env.*.example

# Docker
docker-compose.override.yml

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/

# OS
Thumbs.db

# Dev screenshots / scratch captures (keep out of repo root)
/*.png
/*.jpg
/*.jpeg

# Playwright / MCP debug artifacts
.playwright-mcp/

# Database backups
*.sql.gz
*.dump
infra/docker/backups/

# SSL certs (local dev)
*.pem
*.crt
*.key

# Playwright (E2E)
e2e/test-results/
e2e/playwright-report/

# Resultados de tests y cobertura
**/TestResults/
**/coverage/

# Sesión del admin del seed que guarda el setup del e2e
e2e/tests/.auth/

# Lo genera Next (dev apunta a .next/dev/types, typegen/build a .next/types):
# versionarlo deja el árbol siempre modificado. `type-check` corre next typegen.
storefront/next-env.d.ts

# Logs de `pnpm verify` (scripts/verify.mjs)
.verify/
