{
  "_comment": "Config de webhint (Microsoft Edge Tools). El extension lintea el SOURCE JSX/TSX, no el HTML renderizado, por eso da falsos positivos sistematicos: ve aria-*=\"{expression}\" sin resolver, marca estilos dinamicos (colores de tema, animation-delay) como no-inline-styles, etc. Se apagan esos hints. La accesibilidad real se mide con axe-core sobre la app renderizada, no aca.",
  "hints": {
    "no-inline-styles": "off",
    "axe/aria": "off",
    "axe/forms": "off",
    "axe/name-role-value": "off",
    "axe/structure": "off",
    "axe/text-alternatives": "off",
    "compat-api/css": "off",
    "compat-api/html": "off",
    "disown-opener": "off"
  }
}
