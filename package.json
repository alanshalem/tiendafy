{
  "name": "tiendafy-root",
  "private": true,
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node scripts/verify.mjs",
    "fixtures:api": "node scripts/fixtures-api.mjs",
    "test:load": "node scripts/load-test.mjs",
    "test:smoke": "pnpm --filter tiendafy-e2e exec playwright test --grep @smoke",
    "test:e2e": "pnpm --filter tiendafy-e2e test"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  },
  "lint-staged": {
    "*.{ts,tsx,css,json,yml,yaml}": "prettier --write",
    "*.cs": "dotnet format backend/backend.slnx --no-restore --include"
  }
}
