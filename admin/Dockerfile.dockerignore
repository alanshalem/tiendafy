# Ignore específico de admin/Dockerfile (reemplaza al .dockerignore raíz).
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!admin
!shared
# Manifests de los otros workspaces: pnpm valida el lockfile contra TODOS.
!storefront/package.json
!e2e/package.json
admin/dist
admin/node_modules
admin/coverage
shared/**/node_modules
shared/**/dist
# Secretos (este archivo reemplaza al raíz — repetirlos acá).
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
