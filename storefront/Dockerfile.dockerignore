# Ignore específico de storefront/Dockerfile (reemplaza al .dockerignore raíz):
# el contexto solo lleva lo que el build necesita (storefront + shared + lockfile).
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!storefront
!shared
# Fixtures y helpers de test compartidos: el build typechequea también los tests.
!test-fixtures
# Manifests de los otros workspaces: pnpm valida el lockfile contra TODOS.
!admin/package.json
!e2e/package.json
storefront/.next
storefront/node_modules
storefront/coverage
shared/**/node_modules
shared/**/dist
# Secretos (este archivo reemplaza al raíz — repetirlos acá).
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
