# Copiar a .env.prod y completar. NUNCA commitear .env.prod.
PLATFORM_DOMAIN=tiendafy.com.ar
ACME_EMAIL=vos@tudominio.com
POSTGRES_PASSWORD=cambiar-por-uno-fuerte

# Imágenes (ghcr.io/<usuario>/tiendafy-{api,admin,storefront})
REGISTRY=ghcr.io/OWNER/tiendafy
TAG=latest

# Email (Resend con dominio verificado)
EMAIL_FROM=Tiendafy <no-responder@tudominio.com>
RESEND_API_KEY=
# Signing secret del webhook de Resend (bounces/quejas) — Resend → Webhooks
EMAIL_WEBHOOK_SECRET=

# Mercado Pago (app de plataforma / marketplace)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Secret de webhooks de la app de MP (panel de desarrolladores → Webhooks)
MP_WEBHOOK_SECRET=

# Sentry (opcional; vacío = apagado)
SENTRY_DSN_BACKEND=
SENTRY_DSN_STOREFRONT=
SENTRY_DSN_ADMIN=

# true en la instancia principal; false en réplicas extra de la API
WORKERS_ENABLED=true
