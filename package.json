{
  "name": "tiendafy-root",
  "private": true,
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures:api": "node scripts/fixtures-api.mjs",
    "test:load": "node scripts/load-test.mjs",
    "test:smoke": "pnpm --filter tiendafy-e2e exec playwright test --grep @smoke",
    "test:e2e": "pnpm --filter tiendafy-e2e test"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "*.{ts,tsx,css,json,yml,yaml}": "prettier --write",
    "*.cs": "dotnet format backend/backend.slnx --no-restore --include"
  }
}
