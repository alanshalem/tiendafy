# El borde del servidor (Caddy). Copiar a .env y completar. NUNCA commitear .env
#   cp .env.example .env && chmod 600 .env

# A dónde avisa Let's Encrypt si un certificado tiene problemas.
ACME_EMAIL=admin@tudominio.com

# El dominio de Tiendafy: tiendas en *.dominio, panel en admin., API en api.
TIENDAFY_DOMAIN=tudominio.com

# Cloudflare → My Profile → API Tokens → Create Token → plantilla "Edit zone DNS",
# acotado a la zona de TIENDAFY_DOMAIN. Es para los certificados comodín.
CLOUDFLARE_API_TOKEN=
