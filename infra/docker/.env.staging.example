# STAGING. Copiar a .env.staging y completar. NUNCA commitear .env.*
#
# Regla de oro: staging no puede tocar nada del mundo real. Ni cobrar, ni
# mandar un email a un cliente, ni facturar en ARCA de verdad, ni escribir en
# el bucket de producción. Todo lo de acá es de prueba o está vacío.
COMPOSE_PROJECT_NAME=tiendafy-staging
APP_ENV=staging
STACK_DOMAIN=stg.tiendafy.com.ar

# Puertos en 127.0.0.1, distintos de los de producción (el Caddy del borde los
# distingue por dominio: infra/edge/sites/tiendafy.caddy).
API_PORT=5081
WEB_PORT=3002
ADMIN_PORT=8091

# Imágenes: el MISMO tag que se probó acá es el que después va a producción.
REGISTRY=ghcr.io/alanshalem/tiendafy
TAG=latest

POSTGRES_PASSWORD=cambiar-por-uno-fuerte-y-distinto-al-de-prod

# Marca de ESTA instalacion: lo que ve quien usa el panel. Vacio = Tiendafy.
# El producto es Tiendafy; una instalacion puede llevar la marca de quien la
# opera. No afecta a las tiendas: cada una muestra su propia marca al comprador.
BRAND_NAME=

# Techos de memoria: staging no puede dejar sin RAM a producción.
PG_MEM_LIMIT=512m
API_MEM_LIMIT=768m
WEB_MEM_LIMIT=512m
ADMIN_MEM_LIMIT=128m
# Los datos de staging son descartables: sin backup diario.
BACKUP_REPLICAS=0

# Imágenes: buckets propios de staging (nunca los de producción).
MEDIA_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
MEDIA_PUBLIC_BASE_URL=https://img-stg.tudominio.com
MEDIA_ACCESS_KEY=
MEDIA_SECRET_KEY=
MEDIA_BUCKET=tiendafy-media-stg
MEDIA_PRIVATE_BUCKET=tiendafy-private-stg
MEDIA_REGION=auto
MEDIA_BUCKET_IN_PUBLIC_URL=false
MEDIA_ENSURE_BUCKET=false

# Email: VACÍO A PROPÓSITO. Sin API key, los emails se escriben en el log en
# vez de enviarse. Completar solo para probar entregas, y solo a casillas propias.
EMAIL_FROM=Tiendafy staging <no-responder@tudominio.com>
RESEND_API_KEY=
EMAIL_WEBHOOK_SECRET=

# Mercado Pago: credenciales de PRUEBA (las que empiezan con TEST-).
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=

# Integraciones opcionales: apagadas salvo que se estén probando.
META_APP_ID=
META_APP_SECRET=
SOCIAL_META_APP_ID=
SOCIAL_META_APP_SECRET=
SOCIAL_X_CLIENT_ID=
SOCIAL_X_CLIENT_SECRET=
AI_API_KEY=

SENTRY_DSN_BACKEND=
SENTRY_DSN_STOREFRONT=
SENTRY_DSN_ADMIN=

WORKERS_ENABLED=true
