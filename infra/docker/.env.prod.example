# PRODUCCIÓN. Copiar a .env.prod y completar. NUNCA commitear .env.*
#
# El borde (Caddy, dominios y TLS) va aparte, en infra/edge/.env.
COMPOSE_PROJECT_NAME=tiendafy-prod
APP_ENV=prod
STACK_DOMAIN=tiendafy.com.ar
POSTGRES_PASSWORD=cambiar-por-uno-fuerte

# Qué tienda atiende el dominio pelado (STACK_DOMAIN a secas): su subdominio.
# Vacío = el dominio pelado contesta "tienda no encontrada".
PRIMARY_STORE_SUBDOMAIN=

# Puertos en 127.0.0.1 (solo adentro del servidor; los usa el Caddy del borde,
# infra/edge/sites/tiendafy.caddy). Staging usa otros para no chocar.
API_PORT=5080
WEB_PORT=3000
ADMIN_PORT=8090

# Marca de ESTA instalacion: lo que ve quien usa el panel. Vacio = Tiendafy.
# El producto es Tiendafy; una instalacion puede llevar la marca de quien la
# opera. No afecta a las tiendas: cada una muestra su propia marca al comprador.
BRAND_NAME=

# Techos de memoria (dejan lugar a staging en la misma máquina).
PG_MEM_LIMIT=1g
API_MEM_LIMIT=1g
WEB_MEM_LIMIT=768m
ADMIN_MEM_LIMIT=128m
BACKUP_REPLICAS=1

# Copia de los backups fuera del servidor (base + keyring), cifrada con rclone
# crypt. Apagada mientras OFFSITE_REPLICAS=0. Pasos en docs/DEPLOY.md →
# "Copia fuera del servidor". Con R2: un bucket aparte (tiendafy-backups),
# privado, y un API token con lectura/escritura SOLO sobre ese bucket.
OFFSITE_REPLICAS=0
OFFSITE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
OFFSITE_BUCKET=tiendafy-backups
OFFSITE_ACCESS_KEY=
OFFSITE_SECRET_KEY=
# docker run --rm rclone/rclone:1.75 obscure 'una frase larga'  → pegar la salida.
# La frase en claro va al gestor de contraseñas: sin ella la copia no se abre.
OFFSITE_CRYPT_PASSWORD=

# Imágenes (ghcr.io/<usuario>/tiendafy-{api,admin,storefront})
REGISTRY=ghcr.io/alanshalem/tiendafy
# Vacío a propósito: en producción deploy.sh exige un tag concreto
# (./infra/deploy.sh prod sha-XXXXXXX). "latest" es lo último de main, no lo
# que se probó, y no deja saber a qué volver.
TAG=

# Imágenes de las tiendas (storage S3-compatible).
# Cloudflare R2: panel -> R2 -> crear buckets 'tiendafy-media' y 'tiendafy-private',
# atar un dominio propio (ej. img.tudominio.com) SOLO al de media, y crear un
# API token con permiso de lectura/escritura sobre esos dos buckets.
MEDIA_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
MEDIA_PUBLIC_BASE_URL=https://img.tudominio.com
MEDIA_ACCESS_KEY=
MEDIA_SECRET_KEY=
# R2 firma con region 'auto'. En MinIO/S3 propio poné la que corresponda.
MEDIA_REGION=auto
# false = el objeto vive en la raíz del dominio (R2 con dominio propio).
# true  = {base}/{bucket}/{key} (MinIO o S3 path-style).
MEDIA_BUCKET_IN_PUBLIC_URL=false
# R2 no soporta PutBucketPolicy: los buckets se crean a mano una vez.
MEDIA_ENSURE_BUCKET=false

# Email (Resend con dominio verificado)
EMAIL_FROM=Tiendafy <no-responder@tudominio.com>
RESEND_API_KEY=
# Signing secret del webhook de Resend (bounces/quejas) — Resend → Webhooks
EMAIL_WEBHOOK_SECRET=

# Mercado Pago (app de plataforma / marketplace)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Secret de webhooks de la app de MP (panel de desarrolladores → Webhooks)
MP_WEBHOOK_SECRET=

# Anti-bots de Cloudflare Turnstile en login, registro y contacto. Vacío = sin captcha.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# "Entrar con Google" para compradores (console.cloud.google.com → OAuth). Vacío = oculto.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mercado Libre (developers.mercadolibre.com.ar → app de la plataforma). Vacío = apagado.
# En la app: Redirect URI https://api.<dominio>/api/v1/meli/oauth/callback y
# notificaciones a https://api.<dominio>/api/v1/webhooks/meli (topic orders_v2).
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=

# Meta Ads (developers.facebook.com → tu app → ads_read). Vacío = apagado.
META_APP_ID=
META_APP_SECRET=

# Redes sociales (posts multi-red). Vacío = conector apagado.
# Meta: puede ser la MISMA app de Meta Ads sumando los scopes de páginas/IG.
SOCIAL_META_APP_ID=
SOCIAL_META_APP_SECRET=
# X: app OAuth 2.0 (tweet.read tweet.write users.read offline.access)
SOCIAL_X_CLIENT_ID=
SOCIAL_X_CLIENT_SECRET=

# Aviso de la API al storefront para que un diseño publicado o un cambio de
# catálogo se vea al toque. Un valor largo y al azar (openssl rand -hex 32),
# compartido por la API y el storefront. Vacío = apagado: la tienda vence su
# caché sola en 30 a 60 s.
REVALIDATE_SECRET=

# Sentry (opcional; vacío = apagado)
SENTRY_DSN_BACKEND=
SENTRY_DSN_STOREFRONT=
SENTRY_DSN_ADMIN=

# true en la instancia principal; false en réplicas extra de la API
WORKERS_ENABLED=true

# Sugerencias con IA (console.anthropic.com → API key). Vacio = apagado.
AI_API_KEY=
# Modelo (opcional; default claude-sonnet-5)
AI_MODEL=
