    "@tanstack/react-query": "^5.108.2",
    "@tiendafy/design-system": "workspace:*",
    "@tiendafy/types": "workspace:*",
    "@tiendafy/ui": "workspace:*",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-link": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
