# Borde (Caddy). Copiar a .env.edge y completar. NUNCA commitear .env.*
# Se levanta una vez y no se toca en cada deploy.
PLATFORM_DOMAIN=tiendafy.com.ar
STAGING_DOMAIN=stg.tiendafy.com.ar
ACME_EMAIL=vos@tudominio.com

# Token de Cloudflare para los certificados comodín (DNS-01).
# Cloudflare → My Profile → API Tokens → Create Token → plantilla "Edit zone DNS",
# acotado a la zona del dominio. Con permiso de DNS:Edit alcanza.
CLOUDFLARE_API_TOKEN=
