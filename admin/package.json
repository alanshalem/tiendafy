{
  "name": "tiendafy-admin",
  "version": "0.1.0",
  "description": "Tiendafy e-commerce admin dashboard (React + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
