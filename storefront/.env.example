# Storefront (Next.js) — variables de entorno.
# En dev podés dejar todo en localhost (estos son los defaults si no setéas nada).
# En prod, setealas con tus dominios reales.

# URL de la API desde el servidor (SSR). Prod: https://api.tudominio.com
API_URL=http://localhost:5080

# URL de la API desde el browser (client-side: carrito, favoritos, auth, tracking).
NEXT_PUBLIC_API_URL=http://localhost:5080

# URL del panel admin (CTA "Crear mi tienda" de la landing).
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Dominio base de la plataforma. Detecta landing vs tienda por host:
#   tudominio.com           -> landing de plataforma
#   mitienda.tudominio.com  -> storefront del tenant "mitienda"
# Dev: localhost
PLATFORM_BASE_DOMAIN=localhost
