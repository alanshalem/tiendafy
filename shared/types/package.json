{
  "name": "@tiendafy/types",
  "version": "0.1.0",
  "description": "Tipos compartidos: modelos de dominio + tipos generados desde OpenAPI del backend",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "generate": "openapi-typescript http://localhost:5080/openapi/v1.json -o src/generated/api-schema.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.0",
    "typescript": "^6.0.3"
  }
}
