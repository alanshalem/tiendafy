{
  "name": "tiendafy-storefront",
  "version": "0.1.0",
  "description": "Tiendafy e-commerce storefront (Next.js)",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json,md}\""
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@mercadopago/sdk-react": "^1.0.7",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^8.0.0",
    "@tabler/icons-react": "^3.45.0",
    "@tiendafy/design-system": "workspace:*",
    "@tiendafy/types": "workspace:*",
    "@tiendafy/ui": "workspace:*",
    "lucide-react": "^1.27.0",
    "next": "^15.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-feather": "^2.0.10",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.3.0",
    "jest": "^29.7.0",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "typescript": "^5.3.0",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}
